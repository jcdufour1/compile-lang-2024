coll :: import std.collections

hello_world u8* := "hello"
hello_int u8 := 9

hello_struct coll.Darr(<i32>) := coll.darr_new(<i32>)()

main :: fn() i32 {
    printf("%d\n", hello_int)
    printf("%s\n", hello_world)
    coll.darr_append(&hello_struct, 8);
    printf("%d\n", coll.darr_first(hello_struct))
    return 0
}

printf :: extern("c") fn(format_string u8*, args opaque...) i32
